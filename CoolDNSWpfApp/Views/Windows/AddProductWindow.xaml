<Window x:Class="CoolDNSWpfApp.Views.Windows.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:local="clr-namespace:CoolDNSWpfApp.Views.Windows"
        xmlns:converters="clr-namespace:CoolDNSWpfApp.Converters"
        xmlns:vm="clr-namespace:CoolDNSWpfApp.ViewModels"
        mc:Ignorable="d"
        Title="AddProductWindow" Height="550" Width="900">
    <Window.Resources>
        <converters:TagColorConverter x:Key="TagColorConverter"/>
    </Window.Resources>
    
    <Window.DataContext>
        <vm:AddProductViewModel/>
    </Window.DataContext>

    <Grid Margin="10" ColumnDefinitions="* 0.5* *" VerticalAlignment="Center">
        <Grid RowDefinitions="auto auto auto auto auto auto 
          auto auto auto auto auto auto">

            <Label Content="Введите название"/>
            <TextBox Grid.Row="1" Text="{Binding Product.Name}"/>
            <Label Grid.Row="2" Content="Введите описание"/>
            <TextBox Grid.Row="3" Text="{Binding Product.Description}"/>
            <Label Grid.Row="4" Content="Введите кол-во"/>
            <TextBox Grid.Row="5" Text="{Binding Product.Count}"/>
            <Label Grid.Row="6" Content="Введите скидку (опционально)"/>
            <TextBox Grid.Row="7" Text="{Binding Product.Discount}"/>
            <Label Grid.Row="8" Content="Введите рейтинг"/>
            <TextBox Grid.Row="9" Text="{Binding Product.Rating}"/>
            <Label Grid.Row="10" Content="Введите кол-во отзывов"/>
            <TextBox Grid.Row="11" Text="{Binding Product.FeedbackCount}"/>
            
        </Grid>

        <Grid Grid.Column="2" RowDefinitions="auto auto auto auto auto auto auto auto">
            
            <Grid ColumnDefinitions="auto auto">
                <Label Content="Добавьте хотя бы 2 картинки"/>
                <Button Grid.Column="1" ToolTip="Добавить картинку" Command="{Binding AddImageCommand}"
                        HorizontalAlignment="Left" Style="{DynamicResource AddButtonStyle}">
                    <Button.Content>
                        <svgc:SvgViewbox MaxHeight="15" Stretch="Uniform" Source="/Image/add.svg"/>
                    </Button.Content>
                </Button>
            </Grid>

            <Label Content="Выбраные картинки" Grid.Row="1"/>
            <ListView Grid.Row="2" ItemsSource="{Binding Images}" MinHeight="50" BorderThickness="0"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding}" Margin="0 0 10 0" Width="200" MaxHeight="200" Stretch="Uniform"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Label Grid.Row="3" Content="Добавьте пару тегов"/>
            <ComboBox Grid.Row="4" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}"/>

            <Label Content="Выбраные теги" Grid.Row="5"/>
            <ItemsControl MinHeight="50" Grid.Row="6" ItemsSource="{Binding Selected_tags}"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Id, Converter={StaticResource TagColorConverter}}"
                                CornerRadius="8" Margin="0 0 5 0" Padding="5">

                            <TextBlock Text="{Binding}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Grid.Row="7" Content="Добавить товар" Command="{Binding AddProductCommand}"/>
        </Grid>
    </Grid>
</Window>
