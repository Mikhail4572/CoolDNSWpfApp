<Window x:Class="CoolDNSWpfApp.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoolDNSWpfApp.Views.Windows"
        xmlns:converters="clr-namespace:CoolDNSWpfApp.Converters"
        xmlns:vm="clr-namespace:CoolDNSWpfApp.ViewModels"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="850" Width="1000">
    <Window.Resources>
        <converters:TagColorConverter x:Key="TagColorConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    
    <Grid RowDefinitions="auto * auto">

        <Grid RowDefinitions="auto auto">
            <TextBlock Text="Введите аргумент для поиска"/>
            <TextBox Text="{Binding SearchText}"/>
        </Grid>
        
        <ListView Grid.Row="1" x:Name="LvTest" ItemsSource="{Binding FilterProducts}" HorizontalContentAlignment="Stretch" 
                  ScrollViewer.CanContentScroll="False" ItemContainerStyle="{StaticResource TransparentListViewItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10" ColumnDefinitions="auto, *, *" RowDefinitions="* *" MaxHeight="300">
                        <Grid ColumnDefinitions="* * *">
                            <Button
                                Style="{DynamicResource NextLastButtonStyle}"
                                Command="{Binding DataContext.LastImageCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                CommandParameter="{Binding}">
                                <Button.Content>
                                    <svgc:SvgViewbox MaxHeight="15" Stretch="Uniform" Source="/Image/arrow_left.svg"/>
                                </Button.Content>
                            </Button>

                            <Image Margin="5 0 5 0" Grid.Column="1" Source="{Binding Image}"
                                   Stretch="Uniform" Width="200" MaxHeight="200"/>

                            <Button Grid.Column="2" 
                                    Command="{Binding DataContext.NextImageCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    CommandParameter="{Binding}" Style="{DynamicResource NextLastButtonStyle}">
                                <Button.Content>
                                    <svgc:SvgViewbox MaxHeight="15" Stretch="Uniform" Source="/Image/arrow_right.svg"/>
                                </Button.Content>
                            </Button>
                        </Grid>

                        <Grid Grid.Column="1" RowDefinitions="* * *">
                            <TextBox IsReadOnly="True" Text="{Binding Name}" BorderThickness="0" Background="Transparent"/>
                            <TextBox Grid.Row="1" IsReadOnly="True" Text="{Binding Description}" BorderThickness="0" Background="Transparent"/>

                            <ItemsControl Grid.Row="2" ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Id, Converter={StaticResource TagColorConverter}}" CornerRadius="8"
                                                Margin="0 0 5 0"
                                                Padding="5">

                                            <TextBlock Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2">
            <Button Margin="10" HorizontalAlignment="Left" Padding="2" Style="{DynamicResource AddButtonStyle}">
                <Button.Content>
                    <svgc:SvgViewbox MaxHeight="15" Stretch="Uniform" Source="/Image/add.svg"/>
                </Button.Content>
            </Button>
        </Grid>
    </Grid>
</Window>
